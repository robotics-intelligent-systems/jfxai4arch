        <mxCell id="p6_037" vertex="1" parent="p6_035" value="Availability and metadata status" style="text=1;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;spacing=0;fontFamily=DejaVu Sans;fontSize=22;fontStyle=1;fontColor=#142B43;lineHeight=1.25;connectable=0;">
          <mxGeometry x="18" y="19" width="784" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="p6_038" vertex="1" parent="p6_035" value="reference_only: discovery or bibliography candidate&#10;abstract_available: claims limited to the available abstract&#10;full_text_available: authorized text has been indexed&#10;metadata_reviewed: fields accepted by a reviewer/catalog&#10;Publication/edition status carries its last review or sync date." style="text=1;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;spacing=0;fontFamily=DejaVu Sans;fontSize=19;fontStyle=0;fontColor=#20364A;lineHeight=1.25;connectable=0;">
          <mxGeometry x="18" y="60" width="784" height="179" as="geometry"/>
        </mxCell>
        <mxCell id="p6_039" vertex="1" parent="1" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=0;fillColor=#FCEFF0;strokeColor=#B44B58;strokeWidth=1.5;shadow=0;container=1;recursiveResize=0;">
          <mxGeometry x="930" y="820" width="820" height="255" as="geometry"/>
        </mxCell>
        <mxCell id="p6_040" vertex="1" parent="p6_039" value="" style="rounded=0;arcSize=6;whiteSpace=wrap;html=0;fillColor=#B44B58;strokeColor=#B44B58;strokeWidth=1.5;shadow=0;container=1;recursiveResize=0;">
          <mxGeometry x="0" y="0" width="820" height="6" as="geometry"/>
        </mxCell>
        <mxCell id="p6_041" vertex="1" parent="p6_039" value="Consulted evidence in a specific answer" style="text=1;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;spacing=0;fontFamily=DejaVu Sans;fontSize=22;fontStyle=1;fontColor=#142B43;lineHeight=1.25;connectable=0;">
          <mxGeometry x="18" y="19" width="784" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="p6_042" vertex="1" parent="p6_039" value="A work in a reference list has not necessarily been read.&#10;A retrieved passage must actually support the answer.&#10;Citations point to the version supplied to generation.&#10;Unknown authors, dates or identifiers are never fabricated.&#10;Offline catalogs cannot guarantee current retraction status." style="text=1;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;spacing=0;fontFamily=DejaVu Sans;fontSize=19;fontStyle=0;fontColor=#20364A;lineHeight=1.25;connectable=0;">
          <mxGeometry x="18" y="60" width="784" height="179" as="geometry"/>
        </mxCell>
