        </mxCell>
        <mxCell id="p5_036" vertex="1" parent="1" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=0;fillColor=#EDF4FF;strokeColor=#366CC4;strokeWidth=1.5;shadow=0;container=1;recursiveResize=0;">
          <mxGeometry x="50" y="855" width="820" height="240" as="geometry"/>
        </mxCell>
        <mxCell id="p5_037" vertex="1" parent="p5_036" value="" style="rounded=0;arcSize=6;whiteSpace=wrap;html=0;fillColor=#366CC4;strokeColor=#366CC4;strokeWidth=1.5;shadow=0;container=1;recursiveResize=0;">
          <mxGeometry x="0" y="0" width="820" height="6" as="geometry"/>
        </mxCell>
        <mxCell id="p5_038" vertex="1" parent="p5_036" value="Workstation → team server → private datacenter" style="text=1;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;spacing=0;fontFamily=DejaVu Sans;fontSize=22;fontStyle=1;fontColor=#142B43;lineHeight=1.25;connectable=0;">
          <mxGeometry x="18" y="19" width="784" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="p5_039" vertex="1" parent="p5_036" value="Start with a small corpus and bounded worker concurrency.&#10;Scale CPU parsing/extraction separately from generation.&#10;Use private Kubernetes only when operational needs justify it.&#10;Inherited cloud/Entra/M365 profiles remain optional and separate.&#10;No hardware minimum or performance guarantee is asserted." style="text=1;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;spacing=0;fontFamily=DejaVu Sans;fontSize=18;fontStyle=0;fontColor=#20364A;lineHeight=1.25;connectable=0;">
          <mxGeometry x="18" y="60" width="784" height="164" as="geometry"/>
        </mxCell>
        <mxCell id="p5_040" vertex="1" parent="1" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=0;fillColor=#FFF6E5;strokeColor=#B8791F;strokeWidth=1.5;shadow=0;container=1;recursiveResize=0;">
          <mxGeometry x="930" y="855" width="820" height="240" as="geometry"/>
        </mxCell>
        <mxCell id="p5_041" vertex="1" parent="p5_040" value="" style="rounded=0;arcSize=6;whiteSpace=wrap;html=0;fillColor=#B8791F;strokeColor=#B8791F;strokeWidth=1.5;shadow=0;container=1;recursiveResize=0;">
          <mxGeometry x="0" y="0" width="820" height="6" as="geometry"/>
        </mxCell>
        <mxCell id="p5_042" vertex="1" parent="p5_040" value="Offline acceptance and operations" style="text=1;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;spacing=0;fontFamily=DejaVu Sans;fontSize=22;fontStyle=1;fontColor=#142B43;lineHeight=1.25;connectable=0;">
          <mxGeometry x="18" y="19" width="784" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="p5_043" vertex="1" parent="p5_040" value="Cold start and process fixtures with public egress blocked.&#10;Disable hosted extraction/OCR, remote tracing and consolidation.&#10;Monitor internal service health without logging private text by default.&#10;Restore matching data/index manifests; replay revocations.&#10;Prepare controlled updates and tested rollback." style="text=1;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;spacing=0;fontFamily=DejaVu Sans;fontSize=18;fontStyle=0;fontColor=#20364A;lineHeight=1.25;connectable=0;">
          <mxGeometry x="18" y="60" width="784" height="164" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
