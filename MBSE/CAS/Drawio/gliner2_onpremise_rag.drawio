        <mxCell id="p6_025" vertex="1" parent="p6_022" value="Raw reference string and citation callouts&#10;Citing document/text revision&#10;Candidate local work match&#10;Unresolved or ambiguous → review&#10;No automatic external DOI/PDF fetching" style="text=1;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;spacing=0;fontFamily=DejaVu Sans;fontSize=18;fontStyle=0;fontColor=#20364A;lineHeight=1.25;connectable=0;">
