        <mxCell id="p7_028" vertex="1" parent="p7_026" value="What this package establishes" style="text=1;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;spacing=0;fontFamily=DejaVu Sans;fontSize=22;fontStyle=1;fontColor=#142B43;lineHeight=1.25;connectable=0;">
