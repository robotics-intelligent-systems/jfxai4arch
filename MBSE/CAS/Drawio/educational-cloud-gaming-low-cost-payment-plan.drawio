<mxCell id="t" value="EDUCATIONAL CLOUD GAMING — LOW-COST SUBSCRIPTION PAYMENT PLAN" style="text;html=1;strokeColor=none;fillColor=none;fontSize=25;fontStyle=1;fontColor=#1F2937;" vertex="1" parent="1"><mxGeometry x="45" y="25" width="1250" height="45" as="geometry"/></mxCell>
<mxCell id="s" value="MVP monetization • affordable access • predictable recurring revenue • student-friendly limits" style="text;html=1;strokeColor=none;fillColor=none;fontSize=13;fontColor=#6B7280;" vertex="1" parent="1"><mxGeometry x="47" y="70" width="1100" height="28" as="geometry"/></mxCell>

<mxCell id="h1" value="1. SUBSCRIPTION TIERS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DDEBF7;strokeColor=#5B9BD5;fontStyle=1;fontSize=16;" vertex="1" parent="1"><mxGeometry x="45" y="115" width="1510" height="48" as="geometry"/></mxCell>
<mxCell id="free" value="FREE / DISCOVERY&lt;br&gt;&lt;br&gt;&lt;b&gt;$0 / month&lt;/b&gt;&lt;br&gt;• 60 min cloud play / month&lt;br&gt;• 720p streaming&lt;br&gt;• Low queue priority&lt;br&gt;• Educational catalog&lt;br&gt;• Community support" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2F2F2;strokeColor=#7F7F7F;fontSize=13;spacing=10;" vertex="1" parent="1"><mxGeometry x="45" y="180" width="350" height="210" as="geometry"/></mxCell>
<mxCell id="student" value="STUDENT&lt;br&gt;&lt;br&gt;&lt;b&gt;$4.99 / month&lt;/b&gt;&lt;br&gt;• 10 cloud hours / month&lt;br&gt;• 1080p streaming&lt;br&gt;• Standard queue priority&lt;br&gt;• Saved progress&lt;br&gt;• Learning analytics&lt;br&gt;• Email support" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E2F0D9;strokeColor=#70AD47;fontSize=13;spacing=10;" vertex="1" parent="1"><mxGeometry x="435" y="180" width="350" height="210" as="geometry"/></mxCell>
<mxCell id="plus" value="STUDENT PLUS&lt;br&gt;&lt;br&gt;&lt;b&gt;$8.99 / month&lt;/b&gt;&lt;br&gt;• 25 cloud hours / month&lt;br&gt;• 1080p enhanced bitrate&lt;br&gt;• High queue priority&lt;br&gt;• Advanced analytics&lt;br&gt;• Multiplayer classrooms&lt;br&gt;• Priority support" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=13;spacing=10;" vertex="1" parent="1"><mxGeometry x="825" y="180" width="350" height="210" as="geometry"/></mxCell>
<mxCell id="school" value="SCHOOL / CLASSROOM&lt;br&gt;&lt;br&gt;&lt;b&gt;$3.00 / active student / month*&lt;/b&gt;&lt;br&gt;• Shared classroom pool&lt;br&gt;• Teacher dashboard&lt;br&gt;• SSO / roster integration&lt;br&gt;• Usage controls&lt;br&gt;• Class analytics&lt;br&gt;• Admin support&lt;br&gt;*minimum seat commitment" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EADCF8;strokeColor=#9966CC;fontSize=13;spacing=10;" vertex="1" parent="1"><mxGeometry x="1215" y="180" width="340" height="210" as="geometry"/></mxCell>

<mxCell id="h2" value="2. PAYMENT &amp; BILLING FLOW" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D9E1F2;strokeColor=#4472C4;fontStyle=1;fontSize=16;" vertex="1" parent="1"><mxGeometry x="45" y="420" width="1510" height="48" as="geometry"/></mxCell>
<mxCell id="a" value="SIGN-UP&lt;br&gt;Account + role&lt;br&gt;Student / Teacher / School" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2F2F2;strokeColor=#7F7F7F;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="55" y="495" width="190" height="105" as="geometry"/></mxCell>
<mxCell id="b" value="PLAN SELECTION&lt;br&gt;Free / Student / Plus / School" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2F2F2;strokeColor=#7F7F7F;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="285" y="495" width="210" height="105" as="geometry"/></mxCell>
<mxCell id="c" value="CHECKOUT&lt;br&gt;Hosted payment page&lt;br&gt;Minimize PCI scope" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DDEBF7;strokeColor=#5B9BD5;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="535" y="495" width="210" height="105" as="geometry"/></mxCell>
<mxCell id="d" value="PAYMENT PROVIDER&lt;br&gt;Recurring billing&lt;br&gt;Cards / local methods" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE4D6;strokeColor=#ED7D31;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="785" y="495" width="220" height="105" as="geometry"/></mxCell>
<mxCell id="e" value="BILLING SERVICE&lt;br&gt;Webhooks&lt;br&gt;Idempotency + retries" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E2F0D9;strokeColor=#70AD47;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1045" y="495" width="220" height="105" as="geometry"/></mxCell>
<mxCell id="f" value="ENTITLEMENT ENGINE&lt;br&gt;Plan → quota → access&lt;br&gt;Usage metering" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EADCF8;strokeColor=#9966CC;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1305" y="495" width="220" height="105" as="geometry"/></mxCell>
<mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeWidth=2;" edge="1" parent="1" source="a" target="b"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeWidth=2;" edge="1" parent="1" source="b" target="c"><mxGeometry relative="1" as="geometry"/></mxCell>
