<mxCell id="e4" value="payment event" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeWidth=2;" edge="1" parent="1" source="d" target="e"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e5" value="activate / renew / cancel" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeWidth=2;" edge="1" parent="1" source="e" target="f"><mxGeometry relative="1" as="geometry"/></mxCell>

<mxCell id="h3" value="3. LOW-COST UNIT ECONOMICS &amp; COST CONTROLS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4CCCC;strokeColor=#CC0000;fontStyle=1;fontSize=16;" vertex="1" parent="1"><mxGeometry x="45" y="630" width="730" height="48" as="geometry"/></mxCell>
<mxCell id="cost" value="• Cap cloud gaming hours per tier&lt;br&gt;• Queue-based GPU allocation; no always-on instances&lt;br&gt;• Auto-stop idle sessions after 10–15 minutes&lt;br&gt;• Prefer spot/preemptible capacity where appropriate&lt;br&gt;• Lower-cost GPU tiers for 720p educational workloads&lt;br&gt;• Meter GPU minutes, storage, bandwidth and concurrency&lt;br&gt;• Fair-use and abuse protection&lt;br&gt;• Cost alerts when per-user margin falls below target" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7F7;strokeColor=#E6B8B7;align=left;verticalAlign=top;spacing=12;fontSize=13;" vertex="1" parent="1"><mxGeometry x="45" y="685" width="730" height="190" as="geometry"/></mxCell>

<mxCell id="h4" value="4. REVENUE &amp; PAYMENT POLICY" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E4DFEC;strokeColor=#8064A2;fontStyle=1;fontSize=16;" vertex="1" parent="1"><mxGeometry x="815" y="630" width="740" height="48" as="geometry"/></mxCell>
<mxCell id="policy" value="• Monthly subscription; optional annual plan ~15% discount&lt;br&gt;• Free tier = acquisition funnel / classroom adoption&lt;br&gt;• Student tier = primary consumer MVP offer&lt;br&gt;• School tier = seat-based billing with minimum commitment&lt;br&gt;• Prorated upgrades/downgrades where supported&lt;br&gt;• Failed payment: retry → grace period → restricted access&lt;br&gt;• Cancellation stops renewal; access continues through paid period&lt;br&gt;• Publish refund/tax policy for customer jurisdiction&lt;br&gt;• Never store raw payment-card data in platform services" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBF8FF;strokeColor=#C9B2E6;align=left;verticalAlign=top;spacing=12;fontSize=13;" vertex="1" parent="1"><mxGeometry x="815" y="685" width="740" height="190" as="geometry"/></mxCell>

<mxCell id="footer" value="MVP pricing is a starting hypothesis. Validate against GPU, bandwidth, payment-processing, support and tax costs; review after the first 100–500 active subscribers." style="text;html=1;strokeColor=none;fillColor=none;fontSize=11;fontColor=#7F7F7F;" vertex="1" parent="1"><mxGeometry x="45" y="915" width="1510" height="35" as="geometry"/></mxCell>
</root></mxGraphModel>
