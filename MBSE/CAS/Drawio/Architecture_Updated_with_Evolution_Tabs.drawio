        <mxCell id="title" value="JFXAI4ARCH&#10;Open-Source AI Platform Architecture&#10;Updated architecture with model-compose, HarnessRouter and Microsoft 365 Agents SDK (.NET)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=20;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1">
