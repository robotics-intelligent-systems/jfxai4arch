        <mxCell id="principles" value="Principles&#10;Modular • Self-hosted • Hybrid cloud + local AI • Replaceable components • MCP integration • Enterprise-ready" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;" vertex="1" parent="1">
