        <mxCell id="m1" value="Baseline value&#10;Strong open-source foundation for AI portal, orchestration, retrieval and deployment." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="40" y="450" width="500" height="110" as="geometry" />
        </mxCell>
        <mxCell id="m2" value="Why model-compose?&#10;Adds a specification-driven YAML path without replacing LangGraph. Useful for portable service composition and reproducible deployments." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="590" y="450" width="500" height="110" as="geometry" />
        </mxCell>
        <mxCell id="m3" value="Why HarnessRouter?&#10;Separates harness routing from model routing. Useful for coding agents and local, tool-enabled execution." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="1140" y="450" width="500" height="110" as="geometry" />
        </mxCell>
        <mxCell id="m4" value="Why Microsoft 365 Agents SDK?&#10;Adds a specialized .NET enterprise-agent path for Teams, M365 and Copilot ecosystems." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="1690" y="450" width="460" height="110" as="geometry" />
        </mxCell>
        <mxCell id="strip" value="Deployment profiles&#10;Minimal local | Declarative local | Coding-agent profile | Microsoft enterprise profile | Full hybrid enterprise" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;fontStyle=1;" vertex="1" parent="1">
