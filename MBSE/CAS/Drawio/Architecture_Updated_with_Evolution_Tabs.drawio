        <mxCell id="etitle" value="JFXAI4ARCH — Simplified Evolution&#10;Updated architectural evolution with model-compose, HarnessRouter and Microsoft 365 Agents SDK" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=20;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="520" y="20" width="1160" height="70" as="geometry" />
        </mxCell>
        <mxCell id="egoal" value="Objective&#10;Show the evolution from the baseline open-source AI architecture into a hybrid, modular, multi-runtime enterprise platform." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="20" y="20" width="450" height="70" as="geometry" />
        </mxCell>
        <mxCell id="s1" value="Stage 1 — Baseline Architecture&#10;Open WebUI&#10;LangGraph / LangChain&#10;MCP&#10;Azure AI / local LLMs&#10;Qdrant&#10;PostgreSQL&#10;Docker / Kubernetes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=15;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="180" width="360" height="190" as="geometry" />
        </mxCell>
        <mxCell id="s2" value="Stage 2 — Declarative Automation&#10;Add model-compose&#10;model-compose.yml&#10;Portable YAML definitions&#10;Agents + workflows + RAG + MCP composition" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1f5fe;strokeColor=#26a69a;fontSize=15;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="470" y="180" width="360" height="190" as="geometry" />
        </mxCell>
        <mxCell id="s3" value="Stage 3 — Local Agent Harness Layer&#10;Add HarnessRouter&#10;Unified local harness routing&#10;Codex / other harnesses&#10;Workspace tools: Bash, Git, Files" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=15;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="900" y="180" width="360" height="190" as="geometry" />
        </mxCell>
        <mxCell id="s4" value="Stage 4 — Enterprise .NET Agents&#10;Add Microsoft 365 Agents SDK&#10;Teams / M365 / Copilot Studio&#10;C# / .NET agent services&#10;Azure AI + Semantic Kernel path" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=15;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1330" y="180" width="360" height="190" as="geometry" />
        </mxCell>
        <mxCell id="s5" value="Stage 5 — Full Hybrid Enterprise Platform&#10;Open WebUI + M365 channels&#10;LangGraph + model-compose + .NET agents&#10;HarnessRouter + model router&#10;MCP + RAG + observability + AKS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=15;fontStyle=1;" vertex="1" parent="1">
