  <diagram id="jfxai4arch-codex-roadmap" name="Codex AI + jfxai4arch Development Plan">
    <mxGraphModel dx="1800" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>

        <mxCell id="title" value="PLAN DE DESARROLLO — CODEX AI + JFXAI4ARCH OPEN-SOURCE AI PLATFORM" style="text;html=1;strokeColor=none;fillColor=none;fontSize=25;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="260" y="20" width="1280" height="45" as="geometry"/>
        </mxCell>

        <mxCell id="ref" value="Referencia arquitectónica: robotics-intelligent-systems/jfxai4arch — plataforma modular, portable y self-hosted basada en Open WebUI, FastAPI, LangGraph, MCP, modelos Azure/locales, Qdrant, PostgreSQL, Docker y Kubernetes." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3f2fd;strokeColor=#1565c0;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="180" y="80" width="1440" height="70" as="geometry"/>
        </mxCell>

        <mxCell id="stage1" value="1. ESPECIFICACIÓN + BOOTSTRAP&#10;&lt;b&gt;Semanas 1–2&lt;/b&gt;&#10;• Codex analiza README / issues&#10;• Crear AGENTS.md&#10;• ADR inicial + C4 architecture&#10;• Monorepo y devcontainer&#10;• Docker Compose&#10;• Backlog de Issues&#10;• Licencia + CONTRIBUTING" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff3e0;strokeColor=#ef6c00;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="200" width="300" height="190" as="geometry"/></mxCell>

        <mxCell id="stage2" value="2. AI PORTAL + API&#10;&lt;b&gt;Semanas 3–4&lt;/b&gt;&#10;• Open WebUI&#10;• FastAPI API Gateway&#10;• OAuth2 / OIDC&#10;• Rate limiting + auditing&#10;• PostgreSQL&#10;• Health checks&#10;• OpenAPI" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#2e7d32;fontSize=14;" vertex="1" parent="1"><mxGeometry x="370" y="200" width="300" height="190" as="geometry"/></mxCell>

        <mxCell id="stage3" value="3. AGENT + RAG CORE&#10;&lt;b&gt;Semanas 5–6&lt;/b&gt;&#10;• LangGraph&#10;• Agent routing / state&#10;• Qdrant RAG&#10;• Chunking + embeddings&#10;• PostgreSQL checkpoints&#10;• Evaluation tests&#10;• Human approval" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e5f5;strokeColor=#7b1fa2;fontSize=14;" vertex="1" parent="1"><mxGeometry x="700" y="200" width="300" height="190" as="geometry"/></mxCell>

        <mxCell id="stage4" value="4. MCP + MODEL ROUTER&#10;&lt;b&gt;Semanas 7–8&lt;/b&gt;&#10;• MCP client/server&#10;• PostgreSQL / Git / API tools&#10;• Model Router&#10;• Azure AI&#10;• Ollama / vLLM&#10;• Llama / Qwen / Mistral / Gemma&#10;• Cost/privacy routing" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fce4ec;strokeColor=#c2185b;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1030" y="200" width="300" height="190" as="geometry"/></mxCell>

        <mxCell id="stage5" value="5. DEVSECOPS + OBSERVABILITY&#10;&lt;b&gt;Semanas 9–10&lt;/b&gt;&#10;• GitHub Actions&#10;• Unit/integration/e2e tests&#10;• SAST + dependency scanning&#10;• Langfuse / OpenTelemetry&#10;• Prometheus + Grafana&#10;• SBOM / secrets management&#10;• Release automation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffde7;strokeColor=#f9a825;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1360" y="200" width="300" height="190" as="geometry"/></mxCell>

        <mxCell id="codex" value="CODEX AI — AGENT DE DESARROLLO&#10;&#10;Issue / Spec → Plan → Implement → Test → Review → PR → CI → Feedback → Refactor → Release&#10;&#10;Artefactos: código, tests, ADR, documentación, Dockerfiles, manifests, workflows y changelog." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8eaf6;strokeColor=#3949ab;fontSize=15;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="490" y="450" width="820" height="160" as="geometry"/></mxCell>

        <mxCell id="arch" value="ARQUITECTURA OBJETIVO&#10;&#10;Open WebUI → API Gateway → LangGraph → {MCP Servers + Model Router} → {Azure AI / Local LLMs}&#10;RAG: Documents → Processing → Embeddings → Qdrant → Context → LLM&#10;Data: PostgreSQL&#10;Runtime: Docker → Kubernetes → Azure AKS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1f5fe;strokeColor=#0288d1;fontSize=15;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="420" y="650" width="960" height="180" as="geometry"/></mxCell>

        <mxCell id="repo" value="PORTAFOLIO GITHUB ABIERTO&#10;&#10;README.md · AGENTS.md · docs/architecture · docs/adr · src/ · tests/ · mcp-servers/ · rag-service/ · infra/docker · infra/kubernetes · .github/workflows · CONTRIBUTING.md · SECURITY.md · CHANGELOG.md&#10;&#10;Issues → Branches → Pull Requests → Review → Release" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#424242;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="70" y="650" width="300" height="260" as="geometry"/></mxCell>

        <mxCell id="cloud" value="DEPLOYMENT&#10;&#10;Local&#10;Docker Compose&#10;↓&#10;Kubernetes&#10;↓&#10;Azure AKS&#10;&#10;Azure Key Vault · ACR · PostgreSQL Flexible Server · Azure Monitor" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3f2fd;strokeColor=#1565c0;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1430" y="650" width="300" height="260" as="geometry"/></mxCell>

        <mxCell id="portfolio" value="ENTREGABLE FINAL — 10 SEMANAS&#10;&#10;✓ Plataforma AI self-hosted funcional&#10;✓ RAG con Qdrant&#10;✓ Agente LangGraph&#10;✓ MCP enterprise tools&#10;✓ Model routing Azure + local&#10;✓ PostgreSQL + observabilidad&#10;✓ Docker + Kubernetes&#10;✓ CI/CD GitHub Actions&#10;✓ Documentación arquitectónica&#10;✓ Demo pública + releases&#10;&#10;Resultado: portafolio técnico demostrable de arquitectura Cloud / Microservices / AI." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#2e7d32;fontSize=15;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="470" y="870" width="860" height="190" as="geometry"/></mxCell>

        <mxCell id="kpi" value="KPIs&#10;• 100% CI en main&#10;• ≥80% cobertura objetivo&#10;• 0 secretos en Git&#10;• 5–10 ADRs&#10;• 3–5 releases&#10;• 1 entorno demo&#10;• RAG evaluado&#10;• trazabilidad de agentes&#10;• documentación reproducible" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e0f2f1;strokeColor=#00897b;fontSize=14;" vertex="1" parent="1"><mxGeometry x="70" y="950" width="300" height="110" as="geometry"/></mxCell>

