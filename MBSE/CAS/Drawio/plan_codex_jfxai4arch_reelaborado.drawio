<mxfile host="app.diagrams.net" modified="2026-09-05T15:30:00.000Z" agent="Mozilla/5.0" version="24.7.17">
  <diagram id="jfxai4arch-codex-roadmap" name="Codex AI + jfxai4arch Development Plan">
    <mxGraphModel dx="1800" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>

        <mxCell id="title" value="PLAN DE DESARROLLO — CODEX AI + JFXAI4ARCH OPEN-SOURCE AI PLATFORM" style="text;html=1;strokeColor=none;fillColor=none;fontSize=25;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="260" y="20" width="1280" height="45" as="geometry"/>
        </mxCell>

        <mxCell id="ref" value="Referencia arquitectónica: robotics-intelligent-systems/jfxai4arch — plataforma modular, portable y self-hosted basada en Open WebUI, FastAPI, LangGraph, MCP, modelos Azure/locales, Qdrant, PostgreSQL, Docker y Kubernetes." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3f2fd;strokeColor=#1565c0;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="180" y="80" width="1440" height="70" as="geometry"/>
        </mxCell>

        <mxCell id="stage1" value="1. ESPECIFICACIÓN + BOOTSTRAP<br><b>Semanas 1–2</b><br>• Codex analiza README / issues<br>• Crear AGENTS.md<br>• ADR inicial + C4 architecture<br>• Monorepo y devcontainer<br>• Docker Compose<br>• Backlog de Issues<br>• Licencia + CONTRIBUTING" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff3e0;strokeColor=#ef6c00;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="200" width="300" height="190" as="geometry"/></mxCell>

        <mxCell id="stage2" value="2. AI PORTAL + API<br><b>Semanas 3–4</b><br>• Open WebUI<br>• FastAPI API Gateway<br>• OAuth2 / OIDC<br>• Rate limiting + auditing<br>• PostgreSQL<br>• Health checks<br>• OpenAPI" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#2e7d32;fontSize=14;" vertex="1" parent="1"><mxGeometry x="370" y="200" width="300" height="190" as="geometry"/></mxCell>

        <mxCell id="stage3" value="3. AGENT + RAG CORE<br><b>Semanas 5–6</b><br>• LangGraph<br>• Agent routing / state<br>• Qdrant RAG<br>• Chunking + embeddings<br>• PostgreSQL checkpoints<br>• Evaluation tests<br>• Human approval" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e5f5;strokeColor=#7b1fa2;fontSize=14;" vertex="1" parent="1"><mxGeometry x="700" y="200" width="300" height="190" as="geometry"/></mxCell>

        <mxCell id="stage4" value="4. MCP + MODEL ROUTER<br><b>Semanas 7–8</b><br>• MCP client/server<br>• PostgreSQL / Git / API tools<br>• Model Router<br>• Azure AI<br>• Ollama / vLLM<br>• Llama / Qwen / Mistral / Gemma<br>• Cost/privacy routing" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fce4ec;strokeColor=#c2185b;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1030" y="200" width="300" height="190" as="geometry"/></mxCell>

        <mxCell id="stage5" value="5. DEVSECOPS + OBSERVABILITY<br><b>Semanas 9–10</b><br>• GitHub Actions<br>• Unit/integration/e2e tests<br>• SAST + dependency scanning<br>• Langfuse / OpenTelemetry<br>• Prometheus + Grafana<br>• SBOM / secrets management<br>• Release automation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffde7;strokeColor=#f9a825;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1360" y="200" width="300" height="190" as="geometry"/></mxCell>

        <mxCell id="codex" value="CODEX AI — AGENT DE DESARROLLO<br><br>Issue / Spec → Plan → Implement → Test → Review → PR → CI → Feedback → Refactor → Release<br><br>Artefactos: código, tests, ADR, documentación, Dockerfiles, manifests, workflows y changelog." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8eaf6;strokeColor=#3949ab;fontSize=15;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="490" y="450" width="820" height="160" as="geometry"/></mxCell>

        <mxCell id="arch" value="ARQUITECTURA OBJETIVO<br><br>Open WebUI → API Gateway → LangGraph → {MCP Servers + Model Router} → {Azure AI / Local LLMs}<br>RAG: Documents → Processing → Embeddings → Qdrant → Context → LLM<br>Data: PostgreSQL<br>Runtime: Docker → Kubernetes → Azure AKS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1f5fe;strokeColor=#0288d1;fontSize=15;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="420" y="650" width="960" height="180" as="geometry"/></mxCell>

        <mxCell id="repo" value="PORTAFOLIO GITHUB ABIERTO<br><br>README.md · AGENTS.md · docs/architecture · docs/adr · src/ · tests/ · mcp-servers/ · rag-service/ · infra/docker · infra/kubernetes · .github/workflows · CONTRIBUTING.md · SECURITY.md · CHANGELOG.md<br><br>Issues → Branches → Pull Requests → Review → Release" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#424242;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="70" y="650" width="300" height="260" as="geometry"/></mxCell>

        <mxCell id="cloud" value="DEPLOYMENT<br><br>Local<br>Docker Compose<br>↓<br>Kubernetes<br>↓<br>Azure AKS<br><br>Azure Key Vault · ACR · PostgreSQL Flexible Server · Azure Monitor" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3f2fd;strokeColor=#1565c0;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1430" y="650" width="300" height="260" as="geometry"/></mxCell>

        <mxCell id="portfolio" value="ENTREGABLE FINAL — 10 SEMANAS<br><br>✓ Plataforma AI self-hosted funcional<br>✓ RAG con Qdrant<br>✓ Agente LangGraph<br>✓ MCP enterprise tools<br>✓ Model routing Azure + local<br>✓ PostgreSQL + observabilidad<br>✓ Docker + Kubernetes<br>✓ CI/CD GitHub Actions<br>✓ Documentación arquitectónica<br>✓ Demo pública + releases<br><br>Resultado: portafolio técnico demostrable de arquitectura Cloud / Microservices / AI." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#2e7d32;fontSize=15;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="470" y="870" width="860" height="190" as="geometry"/></mxCell>

        <mxCell id="kpi" value="KPIs<br>• 100% CI en main<br>• ≥80% cobertura objetivo<br>• 0 secretos en Git<br>• 5–10 ADRs<br>• 3–5 releases<br>• 1 entorno demo<br>• RAG evaluado<br>• trazabilidad de agentes<br>• documentación reproducible" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e0f2f1;strokeColor=#00897b;fontSize=14;" vertex="1" parent="1"><mxGeometry x="70" y="950" width="300" height="110" as="geometry"/></mxCell>

